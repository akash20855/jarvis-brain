# ═══════════════════════════════════════════════════════════════════════════
# JARVIS LLM CONFIGURATION - LOCAL & CLOUD AI SETUP
# ═══════════════════════════════════════════════════════════════════════════

## AI PROVIDER SELECTION
## Options: local, openai, anthropic, cohere, huggingface
AI_TYPE=local

## ═══════════════════════════════════════════════════════════════════════════
## LOCAL LLM (OLLAMA) - RUN ON YOUR MAC M4
## ═══════════════════════════════════════════════════════════════════════════

# Enable local LLM
LOCAL_LLM_ENABLED=true

# Ollama service URL (where Ollama is running)
OLLAMA_BASE_URL=http://localhost:11434

# Model for general tasks
OLLAMA_MODEL=mistral
# Other options: llama2, llama2:13b, neural-chat, phi, etc.

# Model for code analysis (specialized for code)
OLLAMA_CODE_MODEL=codellama
# Other options: codellama:34b for more power, mistral

# Model for chat/conversation
OLLAMA_CHAT_MODEL=neural-chat
# Other options: mistral, llama2

# Model for embeddings (if needed)
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Ollama performance tuning for Mac M4
OLLAMA_NUM_THREAD=8          # Number of threads (M4 has 8-10 cores)
OLLAMA_NUM_GPU=0             # Keep at 0 (Apple Silicon doesn't use this)
OLLAMA_CONTEXT_SIZE=2048     # Keep reasonable for M4 (4096 for more memory)
OLLAMA_MEMORY_FRACTION=0.8   # Use up to 80% of available RAM

# Timeout for Ollama requests (seconds)
OLLAMA_REQUEST_TIMEOUT=60

# Keep-alive timeout for Ollama connection
OLLAMA_KEEP_ALIVE=5m

## ═══════════════════════════════════════════════════════════════════════════
## CLOUD AI - OPENAI (GPT-4, Best Capability)
## ═══════════════════════════════════════════════════════════════════════════

# Enable OpenAI
OPENAI_ENABLED=false

# OpenAI API Key
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OpenAI model for general tasks
OPENAI_MODEL=gpt-4-turbo-preview
# Options: gpt-4-turbo-preview, gpt-4, gpt-3.5-turbo

# OpenAI model for code analysis
OPENAI_CODE_MODEL=gpt-4-turbo-preview

# OpenAI model with vision (image analysis)
OPENAI_VISION_MODEL=gpt-4-vision-preview

# Temperature (0-2): Lower = more focused, Higher = more creative
OPENAI_TEMPERATURE=0.7

# Max tokens to generate
OPENAI_MAX_TOKENS=2000

# Request timeout (seconds)
OPENAI_REQUEST_TIMEOUT=30

## ═══════════════════════════════════════════════════════════════════════════
## CLOUD AI - ANTHROPIC CLAUDE (Long Context, Analysis)
## ═══════════════════════════════════════════════════════════════════════════

# Enable Anthropic
ANTHROPIC_ENABLED=false

# Anthropic API Key
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Anthropic model (Claude)
ANTHROPIC_MODEL=claude-3-opus-20240229
# Options: claude-3-opus-20240229, claude-3-sonnet-20240229, claude-3-haiku-20240307

# Max tokens for Claude
ANTHROPIC_MAX_TOKENS=4096

# Temperature
ANTHROPIC_TEMPERATURE=0.7

# Request timeout
ANTHROPIC_REQUEST_TIMEOUT=60

## ═══════════════════════════════════════════════════════════════════════════
## CLOUD AI - COHERE (Fast, Cost-Effective)
## ═══════════════════════════════════════════════════════════════════════════

# Enable Cohere
COHERE_ENABLED=false

# Cohere API Key
# Get from: https://dashboard.cohere.ai
COHERE_API_KEY=

# Cohere model
COHERE_MODEL=command-nightly
# Options: command, command-light, command-nightly

# Max tokens
COHERE_MAX_TOKENS=1000

# Temperature
COHERE_TEMPERATURE=0.8

## ═══════════════════════════════════════════════════════════════════════════
## CLOUD AI - HUGGINGFACE (Open Source)
## ═══════════════════════════════════════════════════════════════════════════

# Enable HuggingFace
HUGGINGFACE_ENABLED=false

# HuggingFace API Key
# Get from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# HuggingFace model (use any HF model)
HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.1

# Base URL if using inference API
HUGGINGFACE_BASE_URL=https://api-inference.huggingface.co/models

## ═══════════════════════════════════════════════════════════════════════════
## HYBRID MODE - USE MULTIPLE PROVIDERS
## ═══════════════════════════════════════════════════════════════════════════

# Use primary + fallback providers
HYBRID_MODE=true

# Primary provider (first choice)
PRIMARY_PROVIDER=local
# Options: local, openai, anthropic, cohere, huggingface

# Secondary/fallback provider
SECONDARY_PROVIDER=openai
# Used if primary fails or is overloaded

# Tertiary provider (optional)
TERTIARY_PROVIDER=anthropic

## ═══════════════════════════════════════════════════════════════════════════
## TASK-SPECIFIC LLM ROUTING
## ═══════════════════════════════════════════════════════════════════════════

# Which provider for each task type:

# Code analysis - use specialized models
CODE_ANALYSIS_PROVIDER=local
# Best: codellama (local) or GPT-4 (OpenAI)

# Code generation/completion
CODE_GENERATION_PROVIDER=local
# Best: codellama, mistral (local) or GPT-4 (OpenAI)

# Natural language analysis
NLP_PROVIDER=local
# Best: mistral (local) or Claude (Anthropic)

# Chat/conversation
CHAT_PROVIDER=local
# Best: neural-chat (local) or Claude (Anthropic)

# Complex reasoning
REASONING_PROVIDER=openai
# Best: GPT-4 (OpenAI) or Claude-Opus (Anthropic)

# Image analysis
VISION_PROVIDER=openai
# Best: GPT-4-Vision (OpenAI)

## ═══════════════════════════════════════════════════════════════════════════
## CACHING & OPTIMIZATION
## ═══════════════════════════════════════════════════════════════════════════

# Enable response caching
CACHE_RESPONSES=true

# Cache TTL in seconds
CACHE_TTL=3600

# Enable prompt compression
COMPRESS_PROMPTS=true

# Batch requests for efficiency
BATCH_REQUESTS=true

## ═══════════════════════════════════════════════════════════════════════════
## FALLBACK / OFFLINE MODE
## ═══════════════════════════════════════════════════════════════════════════

# Enable pattern-based analysis when AI is unavailable
FALLBACK_ANALYSIS_ENABLED=true

# Fallback analysis quality (simple, standard, advanced)
FALLBACK_ANALYSIS_LEVEL=standard

## ═══════════════════════════════════════════════════════════════════════════
## JARVIS BACKEND
## ═══════════════════════════════════════════════════════════════════════════

# Backend port
FLASK_PORT=8001

# Logging level
LOG_LEVEL=INFO

# Project root
PROJECT_ROOT=/Volumes/Akash SSD/repos/jarvis-brain

## ═══════════════════════════════════════════════════════════════════════════
## NOTES & SETUP INSTRUCTIONS
## ═══════════════════════════════════════════════════════════════════════════

# LOCAL LLM SETUP:
# 1. Install Ollama: brew install ollama
# 2. Download model: ollama pull mistral
# 3. Start service: ollama serve
# 4. Jarvis will connect automatically

# OPENAI SETUP:
# 1. Get API key: https://platform.openai.com/api-keys
# 2. Add to this file: OPENAI_API_KEY=sk-...
# 3. Set: OPENAI_ENABLED=true
# 4. Restart Jarvis

# CLAUDE SETUP:
# 1. Get API key: https://console.anthropic.com
# 2. Add to this file: ANTHROPIC_API_KEY=sk-ant-...
# 3. Set: ANTHROPIC_ENABLED=true
# 4. Restart Jarvis

# QUICK SWITCH:
# Run: bash /Volumes/Akash\ SSD/repos/jarvis-brain/switch-ai.sh
