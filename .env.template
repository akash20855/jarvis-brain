# JARVIS Environment Configuration
# Copy this to .env and fill in your values

# === AI Backend Selection ===
# Options: 'claude' (cloud + paid) or 'ollama' (free local)
AI_BACKEND=claude

# === Claude AI Configuration (if using Claude) ===
ANTHROPIC_API_KEY=your_api_key_here

# === Ollama Configuration (if using Ollama) ===
# Download from: https://ollama.ai
# Start with: ollama serve
# Download model: ollama pull llama2
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
OLLAMA_MODEL=llama2

# === Server Configuration ===
JARVIS_PORT=8765
JARVIS_HOST=localhost
JARVIS_DEBUG=false

# === Logging ===
JARVIS_LOG_LEVEL=INFO
JARVIS_LOG_DIR=.jarvis_logs

# === Features ===
ENABLE_AUTO_DEBUG=true
ENABLE_SELF_IMPROVEMENT=true
ENABLE_BUILD_SYSTEM=true

# === Optional Settings ===
JARVIS_TIMEOUT=30
JARVIS_MAX_WORKERS=4
