# Jarvis Brain Configuration - Copy to .env and fill in values

# Core Settings
DEBUG=False
JARVIS_MODE=production
LOG_LEVEL=INFO

# Voice and NLP
AUDIO_DEVICE=default
SPEECH_LANGUAGE=en-US
NLP_MODEL=en_core_web_sm

# Mac Agent
MAC_HOSTNAME=macmini.local
MAC_USERNAME=akash
MAC_PASSWORD=${NEEDS_SECURE_SETUP}

# Windows Agent (if applicable)
WINDOWS_HOSTNAME=windows-pc
WINDOWS_USERNAME=user
WINDOWS_PASSWORD=${NEEDS_SECURE_SETUP}

# Android Device
ANDROID_DEVICE_ID=device_serial_number
ANDROID_PHONE_NUMBER=+1234567890

# WhatsApp Integration
WHATSAPP_MODE=web
WHATSAPP_API_KEY=${GET_FROM_API_PROVIDER}
TWILIO_ACCOUNT_SID=${GET_FROM_TWILIO}
TWILIO_AUTH_TOKEN=${GET_FROM_TWILIO}

# Cloud Settings
CLOUD_PROVIDER=aws
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=${GET_FROM_AWS}
AWS_SECRET_ACCESS_KEY=${GET_FROM_AWS}

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jarvis_brain
DB_USER=jarvis
DB_PASSWORD=${NEEDS_SECURE_SETUP}

# Web Dashboard
DASHBOARD_PORT=8080
DASHBOARD_HOST=0.0.0.0
DASHBOARD_ENABLE_AUTH=True

# Security
SECURITY_KEY=${GENERATE_NEW_KEY}
TOKEN_EXPIRY=3600
MAX_LOGIN_ATTEMPTS=5

# Backup and Sync
BACKUP_ENABLED=True
BACKUP_FREQUENCY=daily
CLOUD_SYNC_ENABLED=True
BACKUP_RETENTION_DAYS=30

# Research and Planning
RESEARCH_ENABLED=True
PLANNING_ENABLED=True

# Monitoring
PROMETHEUS_ENABLED=False
PROMETHEUS_PORT=9090
